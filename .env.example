# ==============================================================================
# MOLE STORE — ENVIRONMENT VARIABLES
# ==============================================================================

# Supabase Project Credentials
# Dapatkan URL dan anon key di Dashboard Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional Server-Side Service Role Key (Hanya untuk server actions / edge functions)
# JANGAN PERNAH expose key ini ke client/browser (tanpa prefix NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Base URL Aplikasi
NEXT_PUBLIC_APP_URL=http://localhost:3000
